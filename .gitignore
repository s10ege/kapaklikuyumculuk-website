# dependencies
node_modules/

# build output
.next/
out/
dist/
build/
/coverage
*.tsbuildinfo
next-env.d.ts

# debug
npm-debug.log*
*.pem

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# env — never commit these
.env
.env*.local

# vercel
.vercel

# os / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# scratch — raw downloads, unsorted photos, exports
scratch/

# agent skills installed from the registry — restore with `npx skills install`.
# skills-lock.json is committed and pins the exact source + hash of each one.
# `npx skills add` writes the real content to .agents/ and symlinks it into
# .claude/skills/, so both are ignored.
#
# Ignore-all-then-unignore rather than naming each installed skill: an explicit
# list silently stops covering the next `skills add`, which is how vendored
# third-party content ends up committed by accident.
.agents/
.claude/skills/*
!.claude/skills/find-skills/
!.claude/skills/ui-ux-pro-max/

# google drive sync scratch — this folder lives inside a synced Drive
.tmp.drive*/

# catalogue source photos — originals stay on Soner's machine
catalogue/raw/

# the same rule for the drop folder the phone photos arrive in, before they are
# renamed into catalogue/raw/. Originals are never committed.
images/

# generated by scripts/catalogue.mjs — rebuilt on every run
catalogue/.cache.json
catalogue/contact-sheet.html

# ⚠ TEMPORARY — DELETE THIS LINE AT ITERATION 2.3 ⚠
# The six trial photographs of iteration 2.1 are a look-test, not the catalogue,
# and must not be published. This ignore is what guarantees that. It also hides
# the REAL catalogue, so it comes out the moment the contact sheet is approved —
# CATALOGUE.md §5 carries the matching checklist item.
/public/urunler/

# project-local skills are OURS and must be committed (see .claude/skills/* above)
!.claude/skills/kk-brand/
!.claude/skills/catalogue-pipeline/
!.claude/skills/project-setup/
