# Normalise line endings. Without this the repo accumulates CRLF/LF churn that
# hides real changes in diffs — six files were already affected before this landed.
* text=auto eol=lf

# Windows batch files. cmd.exe is unreliable with LF-only labels and multi-line
# blocks, so these opt out of the eol=lf rule above.
*.bat text eol=crlf

# Binary assets — never diffed, never normalised
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.mp4  binary
*.glb  binary
*.woff  binary
*.woff2 binary
*.pdf  binary
